# 复制为 .env 后按需改值。真实 .env 不要提交。
#
# ============ PostgreSQL (podman 容器 consumer_goods_pg, pgvector/pgvector:pg16) ============
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=consumer
PGPASSWORD=consumer_dev_2026
PGDATABASE=virtual_human

# ============ LLM —— 对话与骨架生成 ============
# OPENAI_BASE_URL 留空走 OpenAI 官方; 国产模型填其 OpenAI 兼容端点
#   阿里云百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
#   月之暗面:   https://api.moonshot.cn/v1
#   DeepSeek:   https://api.deepseek.com/v1
# OPENAI_API_KEY 留空时: generate 降级 mock 模板 / 嵌入降级伪向量; chat/simulate 会报缺凭证
OPENAI_API_KEY=
OPENAI_BASE_URL=
VH_LLM_MODEL=gpt-4o-mini

# ============ Embedding —— 向量模型 ============
# 库表 kb_embeddings.embedding 是 vector(1024): 超维截断(matryoshka), 不足补零
VH_EMBED_MODEL=text-embedding-3-small

# ============ RustFS 对象存储 —— agent 知识文档 (S3 兼容) ============
# 启动 (podman 或 docker):
#   podman run -d --name rustfs -p 9000:9000 -p 9001:9001 \
#     -e RUSTFS_ACCESS_KEY=rustfsadmin -e RUSTFS_SECRET_KEY=rustfsadmin \
#     -v rustfs-data:/data rustfs/rustfs:latest
# S3 endpoint:  http://127.0.0.1:9000   控制台: http://127.0.0.1:9001 (rustfsadmin/rustfsadmin)
# 目录约定: bucket 内 {persona_id}/docs/...  (每个 agent 一个 docs 目录, 可读可覆盖写)
# 留空 ENDPOINT 则不挂载文档工具
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=vh-docs
RUSTFS_REGION=us-east-1
